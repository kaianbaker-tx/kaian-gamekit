#!/usr/bin/env bash
# new-game "Super Snack Cat" [template]
# Makes a Godot game, a GitHub repo, and a web page - in one step.
set -euo pipefail

GAMES="$HOME/Games"
TEMPLATES="$HOME/GameAssets/templates"
GH_USER="${GAME_GH_USER:-kaianbaker-tx}"

say()  { printf '%s\n' "$*"; }
step() { printf '\n  %s\n' "$*"; }
die()  { printf '\nStopped: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- name
if [ $# -ge 1 ]; then
  NAME="$1"
else
  printf 'What is your game called?  '
  IFS= read -r NAME
fi
[ -n "${NAME:-}" ] || die "A game needs a name."

# "Super Snack Cat" -> "super-snack-cat" for the web address
SLUG="$(printf '%s' "$NAME" \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')"
[ -n "$SLUG" ] || die "That name has no letters or numbers in it."

TEMPLATE="${2:-blank}"
DIR="$GAMES/$NAME"

say ""
say "  Game name:    $NAME"
say "  Folder:       $DIR"
say "  Web address:  https://$GH_USER.github.io/$SLUG/"
say "  Starting from: $TEMPLATE"
say ""

[ -e "$DIR" ] && die "You already have a game called '$NAME'."

# ---------------------------------------------------------------- files
step "Making the folder..."
mkdir -p "$GAMES"

# ------------------------------------------------------------------ web game
# A one-file web game. No engine, no build, no export - the file IS the game,
# and GitHub Pages serves it straight from the top of the repo.
if [ "$TEMPLATE" = "web" ]; then
  mkdir -p "$DIR/shots"

  cat > "$DIR/index.html" <<'WEBSTART'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GAME_NAME</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #0e0d16; color: #f2f0ff; overflow: hidden;
    font: 16px/1.5 system-ui, -apple-system, "Helvetica Neue", sans-serif;
    display: flex; align-items: center; justify-content: center;
    height: 100vh;
  }
  canvas { display: block; max-width: 100vw; max-height: 100vh; image-rendering: pixelated; }
  #overlay {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    background: rgba(14,13,22,.86); padding: 24px;
  }
  #overlay.hidden { display: none; }
  h1 { font-size: clamp(38px, 9vw, 76px); letter-spacing: -.02em; color: #ffd166; }
  p.tag { color: #9a94b8; margin: 6px 0 26px; font-size: 18px; }
  .keys { color: #7d76a0; font-size: 15px; margin-top: 22px; line-height: 1.9; }
  .keys b { color: #f2f0ff; font-weight: 600; }
  .go { color: #6ee7a8; font-weight: 700; letter-spacing: .08em; font-size: 20px; }
</style>
</head>
<body>
<canvas id="c" width="960" height="600"></canvas>

<div id="overlay">
  <h1>GAME_NAME</h1>
  <p class="tag">A game by Kaian</p>
  <div class="go">PRESS ENTER TO START</div>
  <div class="keys">
    <b>&larr; &rarr;</b> move &nbsp;&middot;&nbsp; <b>Space</b> jump &nbsp;&middot;&nbsp; <b>R</b> restart
  </div>
</div>

<script>
// ───────────────────────────────────────────── the parts every game needs
const canvas  = document.getElementById('c');
const ctx     = canvas.getContext('2d');
const overlay = document.getElementById('overlay');

// Which screen are we on? Every game has these three.
let state = 'title';            // 'title' | 'playing' | 'over'

// Everything the game needs to remember while you play lives in here.
// Putting it all in one place means restarting is one line: reset().
let game = {};

function reset() {
  game = {
    x: 120,
    y: 400,
    vy: 0,
    onGround: true,
    score: 0,
  };
}

// ───────────────────────────────────────────── keys
// Held keys go in `keys`. One-off presses are handled in the listener.
const keys = {};
addEventListener('keydown', e => {
  keys[e.code] = true;
  if (e.code === 'Enter' && state !== 'playing') start();
  if (e.code === 'KeyR') start();
  if ([' ', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) e.preventDefault();
});
addEventListener('keyup', e => { keys[e.code] = false; });

function start() {
  reset();
  state = 'playing';
  overlay.classList.add('hidden');
}

// ───────────────────────────────────────────── one step of the game
// update() decides what happens. draw() decides what it looks like.
// Keeping them apart is what stops a game turning into spaghetti.
function update(dt) {
  if (state !== 'playing') return;

  const speed = 320;
  if (keys['ArrowLeft'])  game.x -= speed * dt;
  if (keys['ArrowRight']) game.x += speed * dt;

  if (keys['Space'] && game.onGround) { game.vy = -520; game.onGround = false; }

  game.vy += 1500 * dt;          // gravity
  game.y  += game.vy  * dt;

  const floor = canvas.height - 90;
  if (game.y > floor) { game.y = floor; game.vy = 0; game.onGround = true; }

  game.x = Math.max(20, Math.min(canvas.width - 20, game.x));
}

function draw() {
  ctx.fillStyle = '#141225';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // ground
  ctx.fillStyle = '#2b2745';
  ctx.fillRect(0, canvas.height - 60, canvas.width, 60);

  // you
  ctx.fillStyle = '#ffd166';
  ctx.fillRect(game.x - 18, game.y - 36, 36, 36);

  ctx.fillStyle = '#f2f0ff';
  ctx.font = '600 20px system-ui, sans-serif';
  ctx.fillText('Score ' + game.score, 20, 36);
}

// ───────────────────────────────────────────── the loop
// dt is how long the last frame took, in seconds. Multiplying movement by dt
// is what makes the game run the same speed on a fast and a slow computer.
let last = performance.now();
function frame(now) {
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;
  update(dt);
  draw();
  requestAnimationFrame(frame);
}

reset();
draw();
requestAnimationFrame(frame);
</script>
</body>
</html>
WEBSTART

  # Put his real title into the starter file.
  /usr/bin/sed -i '' "s|GAME_NAME|$NAME|g" "$DIR/index.html" 2>/dev/null \
    || sed -i "s|GAME_NAME|$NAME|g" "$DIR/index.html"

  touch "$DIR/.nojekyll"
  printf '.DS_Store\n' > "$DIR/.gitignore"

  cat > "$DIR/README.md" <<MD
# $NAME

Play it here: **https://$GH_USER.github.io/$SLUG/**

Made by Kaian. It's one single web page - \`index.html\` is the whole game.
MD

  cat > "$DIR/CLAUDE.md" <<MD
# $NAME

Kaian is 10. He reads everything you write, and he talks to you with
voice-to-text, so his spelling will be off - work out what he meant and
keep going instead of asking him to spell it again.

## This game

- It is ONE file: \`index.html\`. HTML, CSS and JavaScript all live in there.
- Keep it one file. No build step, no npm, no extra folders.
- \`update(dt)\` decides what happens, \`draw()\` decides what it looks like.
  Keep those two jobs separate.
- Multiply movement by \`dt\` so the game runs the same on any computer.
- It is published straight from the top of the repo, so whatever is in
  \`index.html\` on \`main\` is what people play.

## Working with him

- Short sentences. One idea at a time.
- Say what you are about to do, then do it, then say what changed.
- Never dump a wall of code at him. Explain the one line that matters.
- \`game-save "what changed"\` after anything that works, using HIS words.
  \`game-undo\` goes back to an earlier save. Nothing is ever lost.
MD

  step "Saving the first version..."
  cd "$DIR"
  git init -q -b main
  git add -A
  # Same fallback identity the rest of the kit uses, so a Mac that has
  # never had `git config --global user.name` set can still save.
  git -c user.name="Kaian" -c user.email="kaian@local" commit -q -m "Start $NAME"

  if gh auth status >/dev/null 2>&1; then
    step "Putting it on GitHub..."
    if gh repo create "$GH_USER/$SLUG" --public --source=. --remote=origin --push >/dev/null 2>&1; then
      say "  Repo:  https://github.com/$GH_USER/$SLUG"
      gh api -X POST "repos/$GH_USER/$SLUG/pages" \
        -f "source[branch]=main" -f "source[path]=/" >/dev/null 2>&1 \
        || gh api -X PUT "repos/$GH_USER/$SLUG/pages" \
        -f "source[branch]=main" -f "source[path]=/" >/dev/null 2>&1 || true
      say "  Web page:  https://$GH_USER.github.io/$SLUG/"
    else
      say "  (Could not make the GitHub repo - maybe it already exists.)"
    fi
  else
    say ""
    say "  GitHub is not logged in yet, so this game is only on this laptop."
    say "  Ask Dad to run:  gh auth login"
  fi

  ln -sfn "$DIR" "$HOME/Desktop/$NAME" 2>/dev/null || true

  say ""
  say "  Done. Open index.html in your browser and it plays right now."
  say ""
  say "  Save a version:  game-save \"what changed\""
  say "  Go back:         game-undo"
  say "  Put it online:   share-game"
  say ""
  exit 0
fi


if [ "$TEMPLATE" != "blank" ]; then
  SRC="$TEMPLATES/$TEMPLATE"
  [ -d "$SRC" ] || die "No template called '$TEMPLATE'. Try: ls $TEMPLATES"
  # Copy the template but never its git history - this is HIS game now.
  cp -R "$SRC" "$DIR"
  rm -rf "$DIR/.git" "$DIR/.github" "$DIR/.godot"
else
  mkdir -p "$DIR"
  cat > "$DIR/project.godot" <<GODOT
; Godot project - made with new-game
config_version=5

[application]
config/name="$NAME"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[rendering]
textures/canvas_textures/default_texture_filter=0
GODOT

  cat > "$DIR/main.tscn" <<'SCENE'
[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]

[node name="Main" type="Node2D"]
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
offset_left = 60.0
offset_top = 60.0
offset_right = 900.0
offset_bottom = 140.0
text = "Your game starts here!"
SCENE

  cat > "$DIR/main.gd" <<'GD'
extends Node2D

# This runs one time when the game starts.
func _ready() -> void:
	print("Hello! The game is running.")


# This runs about 60 times every second.
func _process(_delta: float) -> void:
	pass
GD
fi

# Point the project name at the real title even for templates.
if [ -f "$DIR/project.godot" ]; then
  /usr/bin/sed -i '' "s|^config/name=.*|config/name=\"$NAME\"|" "$DIR/project.godot" 2>/dev/null || true
fi

mkdir -p "$DIR/assets/kenney" "$DIR/shots"

# ---------------------------------------------------------------- web export
step "Setting up the web version..."
# for_mobile MUST stay false: it asks Godot for ETC2/ASTC textures, which
# the project must opt into first, and the export just refuses with a bare
# "configuration errors" if it hasn't. Web builds don't need it anyway.
# thread_support MUST stay false: GitHub Pages cannot send the special
# headers that Godot's threaded web build needs, and the game would
# just show a black screen.
cat > "$DIR/export_presets.cfg" <<'PRESET'
[preset.0]

name="Web"
platform="Web"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter="shots/*"
export_path="docs/index.html"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
variant/extensions_support=false
variant/thread_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=false
html/export_icon=true
html/custom_html_shell=""
html/head_include=""
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=false
progressive_web_app/enabled=false
progressive_web_app/ensure_cross_origin_isolation_headers=true
PRESET

cat > "$DIR/.gitignore" <<'IGN'
# Godot's own scratch files - not part of the game
.godot/
android/

# Mac clutter
.DS_Store

# Big raw files we don't need on GitHub
*.blend1
IGN

# ---------------------------------------------------------------- docs
cat > "$DIR/README.md" <<MD
# $NAME

Play it here: **https://$GH_USER.github.io/$SLUG/**

Made by Kaian with Godot.

## Working on it

\`\`\`
open-game "$NAME"      # open it in Godot
kenney-find spider     # look for art and sounds
share-game             # put the new version online
\`\`\`
MD

cat > "$DIR/CLAUDE.md" <<MD
# $NAME

Kaian is 10. He reads everything you write, and he talks to you with
voice-to-text, so his spelling will be off - work out what he meant and
keep going instead of asking him to spell it again.

## How to talk to him

- Short sentences. One idea at a time.
- Say what you are about to do, then do it, then say what changed.
- When something breaks, say what broke in plain words and fix it.
- Never dump a wall of code at him. Explain the one line that matters.
- \`game-save "what changed"\` after anything that works, using HIS words.
  \`game-undo\` goes back to an earlier save. Nothing is ever lost.

## This game

- Godot 4.7, single web export, published to GitHub Pages.
- Art and sounds come from the Kenney library. Use \`kenney-find <word>\`
  to search it and \`kenney-find <word> --grab\` to copy files into
  \`assets/kenney/\`. Never hand-copy from ~/GameAssets.
- \`share-game\` exports the web build into \`docs/\` and pushes. That is the
  only way the site updates.
- Keep \`variant/thread_support=false\` in export_presets.cfg or the web
  build shows a black screen on GitHub Pages.

## Rules

- Commit small and often, with messages he could read back later.
- Never commit anything from \`shots/\` bigger than a screenshot.
- If he asks for something that would take hours, build the smallest
  version that works first and show him that.
MD

printf '# Art and Sounds\n\nMade by Kenney (kenney.nl), free for anyone to use.\n\n' > "$DIR/CREDITS.md"

# ---------------------------------------------------------------- git
step "Saving the first version..."
cd "$DIR"
git init -q -b main
git add -A
git -c user.name="Kaian" -c user.email="kaian@local" commit -q -m "Start $NAME"

# ---------------------------------------------------------------- github
if gh auth status >/dev/null 2>&1; then
  step "Putting it on GitHub..."
  if gh repo create "$GH_USER/$SLUG" --public --source=. --remote=origin --push >/dev/null 2>&1; then
    say "  Repo:  https://github.com/$GH_USER/$SLUG"
    # Pages serves from /docs on main - share-game fills that folder.
    gh api -X POST "repos/$GH_USER/$SLUG/pages" \
      -f "source[branch]=main" -f "source[path]=/docs" >/dev/null 2>&1 \
      || gh api -X PUT "repos/$GH_USER/$SLUG/pages" \
      -f "source[branch]=main" -f "source[path]=/docs" >/dev/null 2>&1 || true
    say "  Web page will work after your first  share-game"
  else
    say "  (Could not make the GitHub repo - maybe it already exists.)"
  fi
else
  say ""
  say "  GitHub is not logged in yet, so this game is only on this laptop."
  say "  Ask Dad to run:  gh auth login"
fi

# ---------------------------------------------------------------- shortcuts
ln -sfn "$DIR" "$HOME/Desktop/$NAME" 2>/dev/null || true

say ""
say "  Done. Your game is ready."
say ""
say "  Open it:   open-game \"$NAME\""
say "  Find art:  kenney-find cat"
say "  Share it:  share-game"
say ""
